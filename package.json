{
    "name": "music-disc",
    "version": "4.1.3",
    "description": "Discord Music Bot",
    "main": "./src/index.ts",
    "type": "module",
    "scripts": {
        "start": "npm run build && node ./dist/src/index.js",
        "start:server": "node ./dist/src/index.js",
        "build": "npm run build:dashboard && npm run build:server",
        "build:server": "tsc",
        "build:dashboard": "npm --prefix ./dashboard run generate",
        "docker:build": "tsx ./scripts/docker_build.ts",
        "docker:build:test": "tsx ./scripts/docker_build_test.ts",
        "install:dashboard": "npm --prefix ./dashboard ci",
        "dev": "npm run typecheck -- --incremental false && tsx ./src/index.ts",
        "lint": "eslint . --color",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hmes98318/Music-Disc.git"
    },
    "author": "hmes98318",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/hmes98318/Music-Disc/issues"
    },
    "homepage": "https://github.com/hmes98318/Music-Disc#readme",
    "overrides": {
        "body-parser": "^2.2.3",
        "brace-expansion": "^5.0.8"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^13.0.3",
        "cookie": "^2.0.1",
        "discord.js": "~14.27.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "i18next": "^26.3.6",
        "i18next-fs-backend": "^2.6.7",
        "lavashark": "^2.3.3",
        "undici": "^8.10.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/better-sqlite3": "^9.6.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.2.0",
        "eslint": "^10.8.1",
        "globals": "^17.9.0",
        "tsx": "^4.23.12",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.67.0"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
