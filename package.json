{
    "name": "hoeng-bot",
    "version": "4.1.5",
    "description": "Discord Music Bot",
    "main": "./src/index.ts",
    "type": "module",
    "scripts": {
        "start": "npm run build && ./dist/src/index.js",
        "start:server": "npm run build:server && ./dist/src/index.js",
        "build": "npm run build:dashboard && npm run build:server",
        "build:server": "tsc",
        "build:dashboard": "npm --prefix ./dashboard run generate",
        "docker:build": "tsx ./scripts/docker-build.ts",
        "docker:build:test": "tsx ./scripts/docker-build-test.ts",
        "install:dashboard": "npm --prefix ./dashboard ci",
        "dev": "npm run typecheck -- --incremental false && tsx ./src/index.ts",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix && npm format",
        "format": "prettier --write src scripts",
        "format:check": "prettier --check src scripts",
        "typecheck": "tsc --noEmit"
    },
    "author": "hoehoetvhs",
    "license": "MIT",
    "bugs": {
        "url": "https://discord.gg/HMFyw4xeeV"
    },
    "homepage": "https://discord.gg/HMFyw4xeeV",
    "overrides": {
        "body-parser": "^2.4.0",
        "discord.js": {
            "undici": "^6.29.1"
        },
        "@discordjs/rest": {
            "undici": "^6.29.1"
        }
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cookie": "^2.0.2",
        "discord.js": "~14.28.1",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "i18next": "^27.1.2",
        "i18next-fs-backend": "^2.6.12",
        "lavashark": "^2.3.3",
        "undici": "^8.12.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "oxlint": "^1.93.0",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=26"
    }
}
